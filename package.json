{
  "name": "game-recorder",
  "productName": "Game Recorder",
  "version": "0.1.9",
  "description": "Enregistre automatiquement les parties de LoL et Valorant avec pistes audio séparées et highlights",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "author": "letoa",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.1": true,
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "com.letoa.gamerecorder",
    "productName": "Game Recorder",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Game Recorder"
    },
    "directories": {
      "output": "dist"
    }
  }
}
